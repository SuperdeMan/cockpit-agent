+package expo.modules.camera.tasks
+
+import android.os.Bundle
+import expo.modules.kotlin.Promise
+import kotlinx.coroutines.CancellationException
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+
+/** A view-owned request. Disposal invalidates callbacks even before CameraX returns a frame. */
+class MemoryOnlyCapture(private val promise: Promise) {
+  private val state = AtomicInteger(PENDING)
+
+  init {
+    started.incrementAndGet()
+  }
+
+  fun ensureActive() {
+    if (state.get() != PENDING) {
+      throw CancellationException("Memory-only capture is no longer active")
+    }
+  }
+
+  fun complete(response: Bundle) {
+    if (finish(COMPLETED, completed)) {
+      promise.resolve(response)
+    }
+  }
+
+  fun cancel() {
+    if (finish(CANCELLED, cancelled)) {
+      promise.reject("ERR_CAMERA_CAPTURE_CANCELLED", "Memory-only capture was cancelled", null)
+    }
+  }
+
+  fun fail(code: String = "E_TAKING_PICTURE_FAILED", message: String = "Could not capture the memory-only picture") {
+    if (finish(FAILED, failed)) {
+      promise.reject(code, message, null)
+    }
+  }
+
+  private fun finish(next: Int, counter: AtomicLong): Boolean {
+    if (!state.compareAndSet(PENDING, next)) {
+      return false
+    }
+    counter.incrementAndGet()
+    return true
+  }
+
+  companion object {
+    private const val PENDING = 0
+    private const val COMPLETED = 1
+    private const val CANCELLED = 2
+    private const val FAILED = 3
+    private val started = AtomicLong()
+    private val completed = AtomicLong()
+    private val cancelled = AtomicLong()
+    private val failed = AtomicLong()
+
+    fun snapshot(): Map<String, Long> = mapOf(
+      "started" to started.get(),
+      "completed" to completed.get(),
+      "cancelled" to cancelled.get(),
+      "failed" to failed.get()
+    )
+  }
+}
